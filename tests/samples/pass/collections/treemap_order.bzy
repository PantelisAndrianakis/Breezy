// TreeMap/TreeSet: ordered keys, navigation (first/last/floor/ceiling), removal,
// in-order getKeys, and an object key ordered via Comparable. Prints a fixed
// sequence covering each operation.
class Rank
{
	int n;
	Rank(int v) { n = v; }
	int compareTo(Rank o) { return n - o.n; }
}

void main()
{
	TreeMap<int, string> m;
	m = new TreeMap<int, string>();
	m.put(30, "c");
	m.put(10, "a");
	m.put(20, "b");
	print(m.size());            // 3
	print(m.get(20));           // b
	print(m.firstKey());        // 10
	print(m.lastKey());         // 30
	print(m.floorKey(25));      // 20
	print(m.ceilingKey(25));    // 30
	m.remove(20);
	print(m.containsKey(20));   // false
	print(m.size());            // 2

	int[] ks;
	ks = m.getKeys();
	print(ks[0]);               // 10
	print(ks[1]);               // 30

	TreeSet<int> s;
	s = new TreeSet<int>();
	s.add(5);
	s.add(1);
	s.add(3);
	s.add(1);                   // Duplicate ignored.
	print(s.size());            // 3
	print(s.first());           // 1
	print(s.last());            // 5
	print(s.ceiling(2));        // 3
	s.remove(1);
	print(s.first());           // 3

	TreeMap<Rank, string> r;
	r = new TreeMap<Rank, string>();
	r.put(new Rank(9), "x");
	r.put(new Rank(2), "y");
	r.put(new Rank(5), "z");
	Rank[] rk;
	rk = r.getKeys();           // Ordered by Rank.compareTo.
	print(rk[0].n);             // 2
	print(rk[1].n);             // 5
	print(rk[2].n);             // 9
	r.remove(new Rank(5));
	print(r.size());            // 2
}
