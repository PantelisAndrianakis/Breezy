void main()
{
	File.createFile("bzy_attr.txt");

	File.setAttribute("bzy_attr.txt", File.READONLY, true);
	print(File.hasAttribute("bzy_attr.txt", File.READONLY));   // true
	File.setAttribute("bzy_attr.txt", File.READONLY, false);
	print(File.hasAttribute("bzy_attr.txt", File.READONLY));   // false

	File.setAttribute("bzy_attr.txt", File.HIDDEN, true);
	print(File.hasAttribute("bzy_attr.txt", File.HIDDEN));     // true

	File.delete("bzy_attr.txt");
	print(File.exists("bzy_attr.txt"));                        // false
}
