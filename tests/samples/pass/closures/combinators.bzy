// Collection combinators taking lambdas: map (capture an additive base),
// filter (capture a threshold), and reduce (fold to a scalar). Each lambda is a
// closure over the enclosing scope; the combinator loops the receiver's elements
// and calls the closure per element through its code pointer.

void main()
{
	List<int> n = new List<int>();
	for (int i = 1; i <= 5; i = i + 1) { n.add(i); }

	int base = 10;
	List<int> bumped = n.map(x => x + base);             // 11..15.

	int threshold = 13;
	List<int> big = n.filter(x => x + base > threshold);  // x>3 -> originals 4,5.

	print(bumped.get(0));   // 11.
	print(big.size);        // 2.
	print(n.reduce(0, (acc, x) => acc + x));   // 15.
}
