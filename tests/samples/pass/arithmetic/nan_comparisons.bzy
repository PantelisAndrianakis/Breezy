extern long memcpy(float[] destination, byte[] source, long length);
extern long memmove(double[] destination, byte[] source, long length);

int valuesFloat(float a, float b)
{
	bool comparison0 = a == b;
	bool comparison1 = a != b;
	bool comparison2 = a < b;
	bool comparison3 = a > b;
	bool comparison4 = a <= b;
	bool comparison5 = a >= b;
	int result = 0;
	if (comparison0)
	{
		result |= 1;
	}
	if (comparison1)
	{
		result |= 2;
	}
	if (comparison2)
	{
		result |= 4;
	}
	if (comparison3)
	{
		result |= 8;
	}
	if (comparison4)
	{
		result |= 16;
	}
	if (comparison5)
	{
		result |= 32;
	}
	return result;
}

int branchesFloat(float a, float b)
{
	int result = 0;
	if (a == b)
	{
		result |= 1;
	}
	if (a != b)
	{
		result |= 2;
	}
	if (a < b)
	{
		result |= 4;
	}
	if (a > b)
	{
		result |= 8;
	}
	if (a <= b)
	{
		result |= 16;
	}
	if (a >= b)
	{
		result |= 32;
	}
	return result;
}

int loopsFloat(float a, float b)
{
	int result = 0;
	while (a == b)
	{
		result |= 1;
		break;
	}
	while (a != b)
	{
		result |= 2;
		break;
	}
	while (a < b)
	{
		result |= 4;
		break;
	}
	while (a > b)
	{
		result |= 8;
		break;
	}
	while (a <= b)
	{
		result |= 16;
		break;
	}
	while (a >= b)
	{
		result |= 32;
		break;
	}
	return result;
}

