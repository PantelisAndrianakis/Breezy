// Exercises every bitwise operator, both radix literal forms, and the compound
// bitwise assignments. Expected output: 255 15 4 -1 10 16.
void main()
{
	print(0xF0 | 0x0F);   // 255.
	print(0xFF & 0x0F);   // 15.
	print(5 ^ 1);         // 4.
	print(~0);            // -1.
	print(0b1010);        // 10.
	int mask;
	mask = 1;
	mask <<= 4;           // 16 (shift regression).
	mask |= 1;            // 17.
	mask &= 0x1F;         // 17.
	mask ^= 1;            // 16.
	print(mask);          // 16.
}
