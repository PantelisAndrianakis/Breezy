// An affine recurrence loop (x = x * A + B) is advanced many steps at once on the C route.
// The same recurrence with an extra statement in its body runs step by step, so both must agree for every trip count.

long jumpLong(long x, long from, long to)
{
	for (long i = from; i < to; i = i + 1)
	{
		x = x * 6364136223846793005L + 1442695040888963407L;
	}
	return x;
}

long stepLong(long x, long from, long to)
{
	long steps;
	steps = 0;
	for (long i = from; i < to; i = i + 1)
	{
		x = x * 6364136223846793005L + 1442695040888963407L;
		steps = steps + 1;
	}
	return x + steps - steps;
}

int jumpInt(int x, int n)
{
	for (int i = 0; i < n; i = i + 1)
	{
		x = 1103515245 * x + 12345;
	}
	return x;
}

int stepInt(int x, int n)
{
	int steps;
	steps = 0;
	for (int i = 0; i < n; i = i + 1)
	{
		x = 1103515245 * x + 12345;
		steps = steps + 1;
	}
	return x + steps - steps;
}

void main()
{
	int[] counts;
	counts = new int[12];
	counts[0] = 0;
	counts[1] = 1;
	counts[2] = 2;
	counts[3] = 63;
	counts[4] = 64;
	counts[5] = 65;
	counts[6] = 127;
	counts[7] = 128;
	counts[8] = 129;
	counts[9] = 1000;
	counts[10] = 4097;
	counts[11] = -5;
	int agree;
	agree = 1;
	for (int c = 0; c < 12; c = c + 1)
	{
		int n;
		n = counts[c];
		if (jumpLong(7L, -3L, (long)n) != stepLong(7L, -3L, (long)n))
		{
			agree = 0;
		}

		if (jumpInt(99, n) != stepInt(99, n))
		{
			agree = 0;
		}
	}

	print(agree);                       // 1
	print(jumpLong(1L, 0L, 100000L));   // Same value as the step-by-step loop.
	print(stepLong(1L, 0L, 100000L));
	print(jumpInt(1, 100000));
	print(stepInt(1, 100000));
}
