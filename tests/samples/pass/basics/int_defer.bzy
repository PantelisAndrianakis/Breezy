// Regression anchor for deferred-accumulator sign-extension (the 32-bit-native
// loop optimization). Two cases the codegen must get right:
//   1. An int accumulator READ inside the loop must NOT be deferred — each
//      iteration's value (including 32-bit wraparound) must be observable.
//   2. A deferred accumulator that ends NEGATIVE must be re-extended at the loop
//      exit so a later read sees the correct signed value, not a zero-extended one.
void main()
{
	// Case 1: acc is read inside the loop (a[i] = acc), so it stays un-deferred.
	int[] a;
	a = new int[4];
	int acc;
	acc = 0;
	for (int i = 0; i < 4; i = i + 1)
	{
		acc = acc - 1000000000;
		a[i] = acc;
	}

	print(a[0]);
	print(a[1]);
	print(a[2]);
	print(a[3]);

	// Case 2: sum is only self-accumulated in the loop, so it is deferred; it ends
	// negative, exercising the exit re-extension.
	int sum;
	sum = 0;
	for (int k = 0; k < 5; k = k + 1)
	{
		sum = sum - 1000000000;
	}

	print(sum);
}
