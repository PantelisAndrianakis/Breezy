void main()
{
	// Lenient setter roll-over.
	DateTime a = new DateTime(2026, 1, 15);
	a.setMonth(13);                 // -> January 2027.
	print(a.getYear());             // 2027
	print(a.getMonth());            // 1

	DateTime b = new DateTime(2026, 1, 31);
	b.setDay(32);                   // -> February 1.
	print(b.getMonth());            // 2
	print(b.getDay());              // 1

	// Absolute arithmetic.
	DateTime c = new DateTime(2026, 6, 1, 23, 0, 0);
	c.addHours(25);                 // 23:00 + 25h -> June 3 at 00:00.
	print(c.getDay());              // 3
	print(c.getHour());             // 0

	// Month add with day clamping.
	DateTime d = new DateTime(2026, 1, 31);
	d.addMonths(1);                 // Jan 31 -> Feb 28 (clamped).
	print(d.getMonth());            // 2
	print(d.getDay());              // 28

	// Year add clamps a leap day.
	DateTime e = new DateTime(2024, 2, 29);
	e.addYears(1);                  // -> 2025-02-28.
	print(e.getYear());             // 2025
	print(e.getMonth());            // 2
	print(e.getDay());              // 28

	// addDays rolls month boundaries.
	DateTime f = new DateTime(2026, 1, 28);
	f.addDays(5);                   // -> February 2.
	print(f.getMonth());            // 2
	print(f.getDay());              // 2
}
