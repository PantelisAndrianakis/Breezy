void main()
{
	Color c;
	c = Color.GREEN;
	print(c.ordinal());     // 1
	print(c.name());        // GREEN
	print(c.sum());         // 255
	print(Color.RED.r);     // 255
	Color[] all;
	all = Color.values();
	print(all.length);      // 3
	Color v;
	v = Color.valueOf("BLUE");
	print(v.b);             // 255
}
