// Generic enums: construct a payload variant in a typed context and match-bind
// its fields. Each instantiation monomorphizes independently.
void main()
{
	Wrap<int> wi;
	wi = Wrap.Of(9);
	match (wi)
	{
		Of(x) => print(x);        // 9
	}

	Wrap<string> ws;
	ws = Wrap.Of("hi");
	match (ws)
	{
		Of(x) => print(x);        // hi
	}

	Pair2<int, string> p;
	p = Pair2.Both(1, "x");
	match (p)
	{
		Both(a, b) =>
		{
			print(a);
			print(b);             // 1, x
		}
	}
}
