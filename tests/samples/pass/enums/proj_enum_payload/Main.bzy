void main()
{
	Shape s = Shape.Circle(2.0);
	print(s.ordinal());   // 0
	print(s.name());      // Circle

	Shape t = Shape.Rect(3.0, 4.0);
	print(t.ordinal());   // 1

	// Match binds each variant's payload fields into arm-scoped locals.
	match (t)
	{
		Circle(r)  => print(r);
		Rect(w, h) => print(w + h);   // 7
	}
}
