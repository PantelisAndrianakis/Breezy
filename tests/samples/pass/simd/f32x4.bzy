// f32x4: four packed float lanes - pack, lane access (x/y/z/w), element ops,
// and packed load/store over a float[].
void main()
{
	f32x4 a = Simd.pack(1.0, 2.0, 3.0, 4.0);
	f32x4 b = Simd.pack(10.0, 20.0, 30.0, 40.0);

	print(Simd.x(a));   // 1
	print(Simd.w(a));   // 4

	f32x4 s = Simd.add(a, b);
	print(Simd.x(s));   // 11
	print(Simd.w(s));   // 44

	float[] arr = new float[4];
	Simd.store(arr, 0, Simd.mul(a, b));
	print(arr[0]);      // 10
	print(arr[3]);      // 160

	f32x4 v = Simd.load(arr, 0);
	print(Simd.x(v) + Simd.y(v) + Simd.z(v) + Simd.w(v));   // 10+40+90+160=300
}
