// i32x4: four packed int32 lanes - pack, lane access, element ops (paddd/pmulld/
// pminsd/pmaxsd), horizontal sum/dot, and packed load/store over an int[].
void main()
{
	i32x4 a = Simd.pack(1, 2, 3, 4);
	i32x4 b = Simd.pack(10, 20, 30, 40);

	print(Simd.x(a));        // 1
	print(Simd.w(b));        // 40

	i32x4 s = Simd.add(a, b);
	print(Simd.x(s));        // 11
	print(Simd.w(s));        // 44

	print(Simd.sum(a));      // 10
	print(Simd.dot(a, b));   // 300

	i32x4 mx = Simd.max(a, b);
	print(Simd.x(mx));       // 10

	int[] out = new int[4];
	Simd.store(out, 0, Simd.mul(a, b));
	print(out[3]);           // 160

	i32x4 v = Simd.load(out, 0);
	print(Simd.sum(v));      // 10+40+90+160=300
}
