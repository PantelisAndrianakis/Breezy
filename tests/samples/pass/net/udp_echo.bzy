// A server UdpSocket receives one datagram and replies to its sender; a client
// sends "hi" and prints the reply length (2). Proves UDP sendTo/receive parking
// and that the Datagram carries the sender address for the reply.
void server(UdpSocket u, channel<int> portCh)
{
	portCh.send(u.port());
	Datagram d;
	d = u.receive();
	u.sendTo(d.host(), d.port(), d.data());
	u.close();
}

void client(channel<int> portCh)
{
	int port;
	port = portCh.recv();
	UdpSocket u;
	u = Network.udp(0);
	u.sendTextTo("127.0.0.1", port, "hi");
	Datagram d;
	d = u.receive();
	print(d.text().length());     // 2
	u.close();
}

void main()
{
	UdpSocket u;
	u = Network.udp(0);
	channel<int> portCh;
	portCh = new channel<int>(1);
	spawn server(u, portCh);
	spawn client(portCh);
}
