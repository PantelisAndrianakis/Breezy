int add(int a, int b = 10)
{
	return a + b;
}

void main()
{
	print(add(5));       // 15 (b defaults to 10).
	print(add(5, 1));    // 6.

	Box p;
	p = new Box();       // Both default: 1, 2.
	print(p.w);          // 1
	print(p.h);          // 2

	Box q;
	q = new Box(7);      // Second defaults: 7, 2.
	print(q.w);          // 7
	print(q.h);          // 2
}
