# Build artifacts at the project root: the compiler binary (Linux has no .exe)
# plus the per-compile working files written by `breezy` / the codegen test.
breezy
out.asm
out.obj
out_cg_test.asm

# Per-host build dir: runtime objects, lib_breezy.a, and the test binaries.
/build/

# Catch-alls (cover breezy.exe, out.exe, runtime objects, formatter backups).
*.exe
*.o
*.orig

# Editor / local tooling.
.claude/
